# Скопируйте в .env и задайте свой секрет (или передайте через docker compose):
# cp .env.example .env
SESSION_SECRET=change-me-before-use

# Docker: без исходящих запросов (аналитика, GitHub, внешние URL).
# Также задано в wrangler.toml [vars] как глобальный binding воркера.
OFFLINE=true

# Срок жизни документов в KV (секунды, минимум 60). Не задано — без автоудаления.
# Docker Compose по умолчанию: 2592000 (30 дней)
DOCUMENT_DEFAULT_TTL=2592000
